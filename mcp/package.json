{
  "name": "kokon-mcp",
  "version": "0.10.0",
  "mcpName": "io.github.GabrieleLozupone/kokon",
  "license": "AGPL-3.0-only",
  "description": "MCP server for Kokon: generate and edit images offline with Qwen-Image 2.1 on your own GPU. Requires the Kokon desktop app (Windows/macOS).",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "image-generation",
    "image-editing",
    "qwen-image",
    "local",
    "offline",
    "kokon"
  ],
  "author": "Gabriele Lozupone",
  "homepage": "https://kokon.app",
  "bugs": "https://github.com/GabrieleLozupone/kokon/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrieleLozupone/kokon.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "kokon-mcp": "build/kokon-mcp.cjs"
  },
  "files": [
    "build/kokon-mcp.cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=build/kokon-mcp.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:exe": "node scripts/build-exe.mjs",
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
