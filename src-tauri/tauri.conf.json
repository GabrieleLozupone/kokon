{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kokon",
  "mainBinaryName": "Kokon",
  "version": "0.10.0",
  "identifier": "app.kokon.desktop",
  "build": {
    "beforeDevCommand": "npm run bundled && node scripts/dev/sidecars.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run bundled && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kokon",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 660,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kokon",
    "shortDescription": "Create and edit images by describing them, on your own GPU",
    "longDescription": "Kokon creates and edits images from a sentence, privately on your own GPU, with Qwen-Image 2.1 via stable-diffusion.cpp. Everything runs on this PC.",
    "category": "Graphics and Design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kokon-service",
      "binaries/kokon-mcp"
    ],
    "resources": {
      "resources/4xNomos2_hq_mosr.pth": "bundled/4xNomos2_hq_mosr.pth"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEOTYyMjkyRkI1MTQzREQKUldUZFExSDdraUtXL2ZXWWcrNnhNVGZuTnp2UFFrRk1XMFR0em1IWURmcmVEUlJ2bnVscDBCaC8K",
      "endpoints": [
        "https://github.com/GabrieleLozupone/kokon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
